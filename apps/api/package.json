{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "esbuild src/server.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/server.mjs --sourcemap --external:@sentry/node --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "start:prod": "node --enable-source-maps dist/server.mjs",
    "build:edge": "esbuild src/edge.ts --bundle --minify --platform=node --target=es2022 --format=esm --outfile=dist/edge/index.js --external:@sentry/node --external:zod --external:stripe --external:postgres --external:jose && node scripts/edge-deno-json.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "@sentry/node": "^11.16.0",
    "@splash360/api-loyalty": "workspace:*",
    "@splash360/api-menu": "workspace:*",
    "@splash360/contracts": "workspace:*",
    "@splash360/core": "workspace:*",
    "@splash360/db": "workspace:*",
    "@splash360/theme": "workspace:*",
    "hono": "^4.13.20",
    "jose": "^6.2.18",
    "stripe": "^23.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@splash360/config": "workspace:*",
    "@types/node": "^22",
    "eslint": "^9.39.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.1",
    "esbuild": "^0.28.2"
  }
}
