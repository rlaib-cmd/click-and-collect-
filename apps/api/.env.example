PORT=8787
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
CORS_ORIGINS=*
# Secrets : uniquement côté serveur, jamais dans les applications.
# Générer avec : openssl rand -base64 48
ORDER_TOKEN_SECRET=
# Stripe (mode test hors production). Sans ces trois clés, le paiement en ligne est désactivé.
STRIPE_SECRET_KEY=sk_test_
STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_WEBHOOK_SECRET=whsec_
# Géocodeur (format API Adresse) ; « demo » pour travailler hors ligne.
GEOCODER_URL=https://data.geopf.fr/geocodage/search
# Splash360 (lot 14, ADR 0018) : OAuth2 client_credentials, un accès par restaurant.
# URL par défaut : https://api.splash360.fr (jeton sur /oauth/v2/token).
SPLASH360_API_URL=
SPLASH360_CLIENT_ID=
SPLASH360_CLIENT_SECRET=
# Lot 19 (ADR 0024), facultatives : jeton sur api2 (Basic + scope=user), carte v2, export des ventes.
SPLASH360_TOKEN_URL=
SPLASH360_SCOPE=
SPLASH360_MENU_PATH=
SPLASH360_ORDERS_API_URL=
# Export des ventes avec d'autres identifiants (les deux ou aucun ; défaut : identifiants principaux).
SPLASH360_ORDERS_CLIENT_ID=
SPLASH360_ORDERS_CLIENT_SECRET=
# Back-office : sessions Supabase Auth. En production, JWKS : https://<projet>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=
# En local (supabase start), secret HS256 affiché par `supabase status`.
SUPABASE_JWT_SECRET=
# Invitations du back-office (lien « Choisir mon mot de passe ») : URL du projet et clé de service.
# Sans ces deux valeurs, les comptes sont créés sans e-mail d'invitation.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_URL=http://localhost:3000
# App web des clients (https) : retour après 3-D Secure, cartes enregistrées (facultatif)
# CLIENT_APP_URL=https://bella.example.fr
POS_WEBHOOK_SECRET=
EXPO_ACCESS_TOKEN=
# Fidélité (lot 8, ADR 0009) : 'demo' = programme de test, 'off' = sans fidélité.
LOYALTY=demo
# Connexion au club par simple e-mail, sans vérification. Jamais en production.
LOYALTY_DEMO_LOGIN=0
# Connexion du client par code SMS ou e-mail (lot 10, ADR 0012). SMS par Brevo (BREVO_API_KEY).
LOYALTY_OTP=1
# development | recette | production. 'production' coupe toute aide de test.
APP_ENV=development
# Recette sans prestataire : renvoie le code dans la réponse pour tester. Jamais en production.
OTP_DEBUG_ECHO=0
# E-mails de confirmation (Brevo). Sans clé : e-mails seulement journalisés.
BREVO_API_KEY=
EMAIL_SENDER=commande@votre-domaine.fr
EMAIL_SENDER_NAME=Commande en ligne
